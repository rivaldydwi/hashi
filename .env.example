# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# Buat password/secret acak (aman untuk URL):
#   openssl rand -hex 24

# --- Database (dipakai docker compose) ---
DB_OWNER_PASSWORD=ganti-dengan-openssl-rand-hex-24
DB_APP_PASSWORD=ganti-dengan-openssl-rand-hex-24

# --- Auth ---
AUTH_SECRET=ganti-dengan-openssl-rand-hex-32

# --- Akses aplikasi ---
# 0.0.0.0  = bisa dibuka dari LAN/Tailscale (http://IP-OPTIPLEX:3100)
# 127.0.0.1 = hanya dari OptiPlex sendiri (pakai ini kalau sudah lewat Cloudflare Tunnel)
APP_BIND=0.0.0.0
APP_PORT=3100

# --- Data demo ---
# true = tampilkan daftar akun demo di halaman login. Set false sebelum ada data asli!
SHOW_DEMO_ACCOUNTS=true
SEED_PASSWORD=hashi-demo-2026

# --- Hanya untuk development TANPA Docker (npm run dev) ---
# DATABASE_URL=postgresql://hashi_app:PASSWORD@localhost:5432/hashi
# MIGRATE_DATABASE_URL=postgresql://hashi_owner:PASSWORD@localhost:5432/hashi

# --- Cadangan terenkripsi (scripts/backup.sh, scripts/restore.sh; lihat docs/backup.md) ---
# Isi HANYA di lingkungan shell/sesi saat menjalankan, atau di .env lokal yang tidak di-commit. JANGAN menulis nilainya di repo.
# Kunci ini juga HARUS disimpan di luar server (pengelola kata sandi): tanpa kunci, cadangan tidak bisa dibuka.
# HASHI_BACKUP_PASSPHRASE=          # wajib, >= 16 karakter acak (openssl rand -hex 24)
# HASHI_BACKUP_DIR=                 # opsional, bawaan $HOME/hashi-backups
# HASHI_BACKUP_KEEP=                # opsional: simpan N set terbaru buatan skrip (kosong = tidak ada yang dihapus)
